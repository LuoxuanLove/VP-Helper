<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VPHelper.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared application metrics -->
            <Thickness x:Key="PagePadding">24</Thickness>
            <Thickness x:Key="SurfacePadding">16</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="RepeatedItemCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>
            <SolidColorBrush x:Key="MedalGoldBrush" Color="#D6A72D" />
            <SolidColorBrush x:Key="MedalSilverBrush" Color="#98A3AF" />
            <SolidColorBrush x:Key="MedalBronzeBrush" Color="#B87345" />

            <Style x:Key="AppPageTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="38" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AppPageDescriptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AppSectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="24" />
            </Style>
            <Style x:Key="AppTableHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AppSurfaceBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource SurfacePadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="AppIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="AppCommandButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="AppPrimaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="AppCompactButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <local:BoolToVisibilityConverter      x:Key="BoolToVisibility"       xmlns:local="using:VPHelper.WinUI" />
            <local:InverseBoolConverter            x:Key="InverseBool"            xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToFontWeightConverter       x:Key="BoolToFontWeight"       xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToAccentBackgroundConverter x:Key="BoolToAccentBackground" xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToMappingBadgeBackgroundConverter x:Key="BoolToMappingBadgeBackground" xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToMappingBadgeForegroundConverter x:Key="BoolToMappingBadgeForeground" xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToCategoryButtonBackgroundConverter x:Key="BoolToCategoryButtonBackground" xmlns:local="using:VPHelper.WinUI" />
            <local:BoolToCategoryButtonForegroundConverter x:Key="BoolToCategoryButtonForeground" xmlns:local="using:VPHelper.WinUI" />
            <local:NullToVisibilityConverter       x:Key="NullToVisibility"       xmlns:local="using:VPHelper.WinUI" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
