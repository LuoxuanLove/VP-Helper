<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VPHelper.WinUI.Pages.ContestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VPHelper.WinUI.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <Style x:Key="ProblemSortToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
    <Grid x:Name="WorkspaceGrid" MinWidth="732">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContestListColumn" Width="330" MinWidth="250" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="ContestDetailColumn" Width="*" MinWidth="470" />
            <ColumnDefinition x:Name="StandingDividerColumn" Width="6" />
            <ColumnDefinition x:Name="OfficialStandingColumn" Width="360" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="CompactPanelTabs" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Spacing="8" Margin="0,24,24,0" VerticalAlignment="Top" Visibility="Collapsed">
            <ToggleButton x:Name="DetailPanelTab" Content="比赛详情" IsChecked="True" Click="OnDetailPanelClick"/>
            <ToggleButton x:Name="StandingPanelTab" Content="官方榜单" Click="OnStandingPanelClick"/>
        </StackPanel>

        <!-- ── Col 0: contest list ── -->
        <Grid Grid.Column="0" Padding="24,24,8,24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="VP 比赛" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource AppIconButtonStyle}"
                        Click="OnRefresh"
                        ToolTipService.ToolTip="刷新比赛列表">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ContestSearchBox"
                         Grid.Column="0"
                         PlaceholderText="搜索比赛"
                         TextChanged="OnContestSearchTextChanged"
                         ToolTipService.ToolTip="可组合关键词：名称、年份、Gym/QOJ 编号、账号、CF、QOJ、已绑定、未绑定、VP、练习" />
                <Button Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource AppIconButtonStyle}"
                        Click="OnClearContestSearch"
                        IsEnabled="{x:Bind Vm.HasContestSearch, Mode=OneWay}"
                        ToolTipService.ToolTip="清空搜索">
                    <FontIcon Glyph="&#xE894;" FontSize="14" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{x:Bind Vm.ContestSearchSummary, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Contests}"
                       SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                       SelectionMode="Single"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GymContestItem">
                        <StackPanel Padding="10,8" Spacing="3">
                            <!-- Platform badge + title -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Padding="6,2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind PlatformBadge}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DisplayTitle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind SolvedText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StartTimeText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind Vm.ShowContestSearchEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE721;"
                          FontSize="28"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="未找到匹配比赛"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Text="试试赛事名称、年份、Gym/QOJ 编号或筛选词"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border x:Name="LeftResizeHandle"
                Grid.Column="1"
                Background="Transparent"
                PointerEntered="OnResizeHandlePointerEntered"
                PointerExited="OnResizeHandlePointerExited"
                PointerPressed="OnLeftResizePointerPressed"
                PointerMoved="OnResizePointerMoved"
                PointerReleased="OnResizePointerReleased"
                PointerCaptureLost="OnResizePointerReleased">
            <Rectangle x:Name="LeftResizeIndicator"
                       Width="2"
                       HorizontalAlignment="Center"
                       RadiusX="1"
                       RadiusY="1"
                       Opacity="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Border>

        <!-- ── Col 2: VP detail ── -->
        <Border x:Name="DetailPanel" Grid.Column="2" Margin="0,24,0,24"
                Style="{StaticResource AppSurfaceBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="比赛详情"
                           Style="{StaticResource AppSectionTitleTextBlockStyle}" />

                <Grid Grid.Row="1">
                    <Grid RowSpacing="14"
                      Visibility="{x:Bind Vm.ShowDetailContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <HyperlinkButton Tag="{x:Bind Vm.SelectedRanklandUrl, Mode=OneWay}"
                                         Padding="0"
                                         HorizontalAlignment="Left"
                                         HorizontalContentAlignment="Left"
                                         Click="OnContestRanklandClick"
                                         ToolTipService.ToolTip="在默认浏览器打开 Rankland 榜单"
                                         Visibility="{x:Bind Vm.HasSelectedRanklandUrl, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{x:Bind Vm.DetailTitle, Mode=OneWay}"
                                           Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <FontIcon Glyph="&#xE8A7;"
                                          FontSize="13"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </HyperlinkButton>
                        <TextBlock Text="{x:Bind Vm.DetailTitle, Mode=OneWay}"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind Vm.HasSelectedRanklandUrl, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Text="{x:Bind Vm.VpSummary, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Estimate card -->
                    <Border Grid.Row="1" CornerRadius="{StaticResource RepeatedItemCornerRadius}" Padding="16,13"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Visibility="{x:Bind Vm.HasEstimate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="推算名次"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Vm.EstimateRankText, Mode=OneWay}"
                                           FontSize="30"
                                           LineHeight="36"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Vm.EstimateTotalText, Mode=OneWay}"
                                           Margin="0,0,0,5"
                                           VerticalAlignment="Bottom"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        ToolTipService.ToolTip="{x:Bind Vm.MedalLineSourceDetail, Mode=OneWay}"
                                        Visibility="{x:Bind Vm.HasMedalLines, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource MedalGoldBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Vm.GoldMedalLineText, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource MedalGoldBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource MedalSilverBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Vm.SilverMedalLineText, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource MedalSilverBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource MedalBronzeBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Vm.BronzeMedalLineText, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{StaticResource MedalBronzeBrush}" />
                                </StackPanel>
                             </StackPanel>
                         </StackPanel>
                        <Grid Grid.Column="1"
                              Width="108"
                              Height="82"
                              HorizontalAlignment="Right"
                              ToolTipService.ToolTip="{x:Bind Vm.EstimatedAwardToolTip, Mode=OneWay}">
                            <Grid Width="78"
                                  Height="61"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                                <Polygon Points="18,0 37,0 33,31 14,25"
                                         Fill="{x:Bind Vm.EstimatedAwardRibbonBrush, Mode=OneWay}" />
                                <Polygon Points="41,0 60,0 64,25 45,31"
                                         Fill="{x:Bind Vm.EstimatedAwardRibbonBrush, Mode=OneWay}" />
                                <Ellipse Width="54"
                                         Height="54"
                                         VerticalAlignment="Bottom"
                                         Fill="{x:Bind Vm.EstimatedAwardBrush, Mode=OneWay}"
                                         Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                         StrokeThickness="1" />
                                <Ellipse Width="44"
                                         Height="44"
                                         VerticalAlignment="Bottom"
                                         Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                         StrokeThickness="1" />
                                <TextBlock Text="{x:Bind Vm.EstimatedAwardSymbol, Mode=OneWay}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,10"
                                           HorizontalAlignment="Center"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind Vm.EstimatedAwardForegroundBrush, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.EstimatedAwardTitle, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind Vm.EstimatedAwardBrush, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                    </Border>

                    <!-- Per-problem results -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="题目情况"
                                   Style="{StaticResource AppSectionTitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Padding="2"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="DifficultySortButton"
                                              Content="难度"
                                              IsChecked="True"
                                              Style="{StaticResource ProblemSortToggleButtonStyle}"
                                              Click="OnDifficultySortClick"
                                              ToolTipService.ToolTip="按官方通过数降序；通过数相同则按提交数升序" />
                                <ToggleButton x:Name="ContestOrderSortButton"
                                              Content="题号顺序"
                                              Style="{StaticResource ProblemSortToggleButtonStyle}"
                                              Click="OnContestOrderSortClick"
                                              ToolTipService.ToolTip="按赛事原始题号顺序显示" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" ColumnSpacing="6" Padding="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="72" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="题目" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="通过" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="罚时" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="通过时间" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="5" Text="补题" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    </Grid>
                    <ListView Grid.Row="4" ItemsSource="{x:Bind Vm.Problems}" SelectionMode="None">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProblemDetailItem">
                            <Grid ColumnSpacing="6" Padding="2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="72" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Index}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind HasTitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ThroughText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StatusText}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PenaltyText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind FirstAcText}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <HyperlinkButton Grid.Column="5"
                                                     Content="打开"
                                                     Padding="0"
                                                     VerticalAlignment="Center"
                                                     Tag="{x:Bind ProblemUrl}"
                                                     IsEnabled="{x:Bind HasProblemUrl}"
                                                     Click="OnProblemLinkClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind Vm.ShowDetailEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE8A1;" FontSize="36"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="暂无比赛详情"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="请从左侧选择一场比赛。"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind Vm.IsDetailLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="{x:Bind Vm.IsDetailLoading, Mode=OneWay}"
                                      Width="36"
                                      Height="36" />
                        <TextBlock Text="正在加载比赛详情..."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="RightResizeHandle"
                Grid.Column="3"
                Background="Transparent"
                PointerEntered="OnResizeHandlePointerEntered"
                PointerExited="OnResizeHandlePointerExited"
                PointerPressed="OnRightResizePointerPressed"
                PointerMoved="OnResizePointerMoved"
                PointerReleased="OnResizePointerReleased"
                PointerCaptureLost="OnResizePointerReleased">
            <Rectangle x:Name="RightResizeIndicator"
                       Width="2"
                       HorizontalAlignment="Center"
                       RadiusX="1"
                       RadiusY="1"
                       Opacity="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Border>

        <!-- ── Col 4: official standings ── -->
         <Border x:Name="StandingPanel" Grid.Column="4" Margin="0,24,24,24"
                 Style="{StaticResource AppSurfaceBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="官方榜单"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Grid.Column="1"
                            Padding="7,2"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind Vm.HasMedalLines, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            ToolTipService.ToolTip="{x:Bind Vm.MedalLineSourceDetail, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.MedalLineSourceText, Mode=OneWay}"
                                   FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind Vm.HasMedalLines, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Rectangle Width="14" Height="2" Fill="{StaticResource MedalGoldBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="金牌线" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Rectangle Width="14" Height="2" Fill="{StaticResource MedalSilverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="银牌线" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Rectangle Width="14" Height="2" Fill="{StaticResource MedalBronzeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="铜牌线" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Placeholder when not mapped or no standings loaded -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind Vm.ShowOfficialPlaceholder, Mode=OneWay,
                                         Converter={StaticResource BoolToVisibility}}">
                    <FontIcon Glyph="&#xE71B;" FontSize="36"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.OfficialPlaceholderTitle, Mode=OneWay}" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.OfficialPlaceholderMessage, Mode=OneWay}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- Standings table -->
                <ListView x:Name="OfficialStandingsList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind Vm.OfficialStandings}"
                          SelectionMode="None"
                          Visibility="{x:Bind Vm.ShowOfficialStandings, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OfficialStandingItem">
                            <StackPanel>
                                <Border Padding="8,6" Margin="0,1" CornerRadius="4"
                                        Background="{x:Bind IsVpRow,
                                            Converter={StaticResource BoolToAccentBackground}}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind RankText}"
                                                   FontWeight="{x:Bind IsVpRow, Converter={StaticResource BoolToFontWeight}}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TeamName}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="{x:Bind IsVpRow, Converter={StaticResource BoolToFontWeight}}" />
                                            <TextBlock Text="{x:Bind Organization}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind Organization, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SolvedCount}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind PenaltyText}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>

                                <Grid Height="24" Margin="8,2" ColumnSpacing="8"
                                      Visibility="{x:Bind ShowGoldBoundary, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource MedalGoldBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{StaticResource MedalGoldBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind GoldBoundaryText}" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MedalGoldBrush}" />
                                    </Border>
                                </Grid>
                                <Grid Height="24" Margin="8,2" ColumnSpacing="8"
                                      Visibility="{x:Bind ShowSilverBoundary, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource MedalSilverBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{StaticResource MedalSilverBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind SilverBoundaryText}" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MedalSilverBrush}" />
                                    </Border>
                                </Grid>
                                <Grid Height="24" Margin="8,2" ColumnSpacing="8"
                                      Visibility="{x:Bind ShowBronzeBoundary, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource MedalBronzeBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{StaticResource MedalBronzeBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind BronzeBoundaryText}" FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MedalBronzeBrush}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2"
                        CornerRadius="{StaticResource RepeatedItemCornerRadius}"
                        Visibility="{x:Bind Vm.IsDetailLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <ProgressRing IsActive="{x:Bind Vm.IsDetailLoading, Mode=OneWay}"
                                      Width="36"
                                      Height="36" />
                        <TextBlock Text="正在加载官方榜单..."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
