<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VPHelper.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VPHelper.WinUI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1560" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="统计概览" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.LastRefreshedText, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AppIconButtonStyle}"
                        Click="OnRefresh"
                        ToolTipService.ToolTip="刷新统计数据">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="浏览官方比赛" Tag="gymdirectory" Click="OnNavigate" Style="{StaticResource AppPrimaryButtonStyle}"/>
                <Button Content="查看 VP 成绩" Tag="contests" Click="OnNavigate" Style="{StaticResource AppCompactButtonStyle}"/>
                <Button Content="管理账号" Tag="login" Click="OnNavigate" Style="{StaticResource AppCompactButtonStyle}"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,56,0,0"
                        Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE9D9;" FontSize="42"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="暂无 VP 数据" HorizontalAlignment="Center"
                           Style="{StaticResource AppSectionTitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="请先在「账号管理」页面登录并同步 Codeforces 或 QOJ 账号。"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button Content="前往账号管理" Click="OnGoToLogin" HorizontalAlignment="Center"
                        Style="{StaticResource AppPrimaryButtonStyle}" />
            </StackPanel>

            <!-- Stat cards (hidden when empty) -->
            <ItemsControl ItemsSource="{x:Bind Vm.StatCards, Mode=OneWay}"
                          Loaded="OnStatCardsLoaded" SizeChanged="OnStatCardsSizeChanged"
                          Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCardItem">
                        <Border CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="14,14" Height="116" Margin="0,0,10,10" HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="17"
                                          HorizontalAlignment="Left"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Text="{x:Bind Value}"
                                           FontSize="25" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="{x:Bind Label}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent VP list -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最近 VP 比赛"
                               Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource AppIconButtonStyle}"
                                Click="OnPreviousPage"
                                IsEnabled="{x:Bind Vm.CanGoPrevious, Mode=OneWay}"
                                ToolTipService.ToolTip="上一页">
                            <FontIcon Glyph="&#xE76B;" FontSize="13" />
                        </Button>
                        <TextBlock Text="{x:Bind Vm.PageText, Mode=OneWay}"
                                   MinWidth="42"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource AppIconButtonStyle}"
                                Click="OnNextPage"
                                IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"
                                ToolTipService.ToolTip="下一页">
                            <FontIcon Glyph="&#xE76C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind Vm.RecentVps, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentVpItem">
                            <Button Padding="0" Margin="0,0,0,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnRecentContestClick">
                                <Border CornerRadius="{StaticResource RepeatedItemCornerRadius}" Padding="14,10"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind PlatformBadge}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayTitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind Handle}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind StartTimeText}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{x:Bind SolvedText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
