<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VPHelper.WinUI.Pages.GymDirectoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:VPHelper.WinUI.ViewModels">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16" MaxWidth="1608">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="官方比赛" Style="{StaticResource AppPageTitleTextBlockStyle}"/>
                <TextBlock Text="查找赛事、查看本地 VP 成绩与推算排名，再选择下一场训练。"
                           Style="{StaticResource AppPageDescriptionTextBlockStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="更新目录和榜单" Click="OnRefresh" VerticalAlignment="Center"
                    IsEnabled="{x:Bind Vm.IsReady, Mode=OneWay}" Style="{StaticResource AppCompactButtonStyle}"
                    ToolTipService.ToolTip="从 Rankland 更新赛事目录，并重新读取本地参赛记录"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="搜索名称、年份或比赛 ID" Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索官方比赛" MinHeight="36"/>
            <ComboBox x:Name="CategoryPicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnCategoryChanged" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="赛事类别">
                <ComboBoxItem Content="全部赛事" Tag="All"/><ComboBoxItem Content="总决赛" Tag="Final"/>
                <ComboBoxItem Content="ICPC 区域赛" Tag="IcpcRegional"/><ComboBoxItem Content="CCPC 区域赛" Tag="CcpcRegional"/>
                <ComboBoxItem Content="省赛及邀请赛" Tag="ProvincialInvitational"/>
            </ComboBox>
            <ComboBox Grid.Column="2" SelectedIndex="{x:Bind Vm.ParticipationFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="参赛状态">
                <ComboBoxItem Content="全部状态"/><ComboBoxItem Content="已 VP"/><ComboBoxItem Content="未 VP"/><ComboBoxItem Content="仅练习"/>
            </ComboBox>
        </Grid>
        <InfoBar Grid.Row="2" IsOpen="{x:Bind Vm.HasWarning, Mode=OneWay}"
                 IsClosable="False" Severity="Warning" Message="{x:Bind Vm.Status, Mode=OneWay}"/>
        <Border Grid.Row="3" Style="{StaticResource AppSurfaceBorderStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource AppSectionTitleTextBlockStyle}"/>
                <TextBlock Grid.Row="1" Text="排名按本地官方榜单推算；多个账号或赛场的成绩可在「查看成绩」中分别打开。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"
                              SizeChanged="OnDirectoryViewportSizeChanged">
                    <Grid x:Name="DirectoryTable" MinWidth="850" RowSpacing="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Padding="8,0,24,0" MinHeight="34" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="92"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Text="比赛名称" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="1" Text="日期" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="2" Text="题数" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="3" Text="参赛状态" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="4" Text="推算排名" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="5" Text="CF Gym" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="6" Text="QOJ" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                            <TextBlock Grid.Column="7" Text="本地成绩" Style="{StaticResource AppTableHeaderTextBlockStyle}"/>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Items}" SelectionMode="None"
                                  Visibility="{x:Bind Vm.IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                            </Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate x:DataType="vm:GymDirectoryItem">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid Padding="8,9,24,9" MinHeight="62" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="92"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   ToolTipService.ToolTip="{x:Bind DisplayName}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DateDisplay}" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ProblemCountText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind ParticipationText}" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind RankText}" VerticalAlignment="Center" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RankText}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <HyperlinkButton Grid.Column="5" Content="{x:Bind GymLinkText}" Tag="{x:Bind GymUrl}" Click="OnGymUrlClick"
                                                         Padding="0" IsEnabled="{x:Bind HasGymUrl}" ToolTipService.ToolTip="{x:Bind GymUrl}" FontSize="12"/>
                                        <HyperlinkButton Grid.Column="6" Content="{x:Bind QojLinkText}" Tag="{x:Bind QojUrl}" Click="OnQojUrlClick"
                                                         Padding="0" IsEnabled="{x:Bind HasQojUrl}" ToolTipService.ToolTip="{x:Bind QojUrl}" FontSize="12"/>
                                        <StackPanel Grid.Column="7" Spacing="2" VerticalAlignment="Center">
                                            <HyperlinkButton Content="{x:Bind ResultHint}" Tag="{x:Bind}" Click="OnResultsClick" Padding="0"
                                                             IsEnabled="{x:Bind HasLocalResult}" FontSize="12"/>
                                            <HyperlinkButton Content="官方榜单 ↗" Tag="{x:Bind RanklandUrl}" Click="OnRanklandUrlClick" Padding="0" FontSize="11"
                                                             Visibility="{x:Bind HasRanklandUrl, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Width="32" Height="32"/>
                    <TextBlock Text="正在加载官方比赛…"/>
                </StackPanel>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind Vm.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="没有符合条件的比赛" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="试试其他关键词，或重置筛选。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="重置筛选" Click="OnResetFilters" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="基于已同步账号与已确认关联 · 数据来源：algoux/srk-collection (AGPL-3.0)"
                           FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
