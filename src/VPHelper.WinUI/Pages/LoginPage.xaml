<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VPHelper.WinUI.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:VPHelper.WinUI.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="{StaticResource PagePadding}"
          MaxWidth="1600"
          HorizontalAlignment="Stretch"
          ColumnSpacing="20"
          RowSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="账号管理" Style="{StaticResource AppPageTitleTextBlockStyle}" />
            <TextBlock Text="先选择平台并登录，再点击「同步该账号」；登录本身不会开始同步。"
                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
        </StackPanel>

        <!-- ===== Left: platform tabs + browser ===== -->
        <Grid Grid.Row="1" Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom tabs keep the state card flush with the shared browser surface. -->
            <Grid Grid.Row="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="26">
                    <Button x:Name="CfPlatformTab"
                            Width="146"
                            Height="42"
                            Background="Transparent"
                            Click="OnSelectCfPlatform" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Codeforces 平台"
                            ToolTipService.ToolTip="切换到 Codeforces">
                        <Grid>
                            <TextBlock Text="Codeforces"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Border x:Name="CfTabIndicator"
                                    Height="3"
                                    Width="92"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="QojPlatformTab"
                            Width="56"
                            Height="42"
                            Background="Transparent"
                            Click="OnSelectQojPlatform" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="QOJ 平台"
                            ToolTipService.ToolTip="切换到 QOJ">
                        <Grid>
                            <TextBlock Text="QOJ"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Border x:Name="QojTabIndicator"
                                    Height="3"
                                    Width="40"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Border x:Name="CfLoginStatePanel"
                            MinHeight="58"
                            Padding="14,9"
                            CornerRadius="{StaticResource RepeatedItemCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind Vm.CfShowInitializing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}"
                                         Visibility="{x:Bind Vm.CfShowChallenge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                         Visibility="{x:Bind Vm.CfShowNotLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind Vm.CfShowLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Vm.CfStateTitle, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Vm.CfStatus, Mode=OneWay}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="同步该账号"
                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                    Click="OnSyncCf"
                                    IsEnabled="{x:Bind Vm.CanSyncCf, Mode=OneWay}"
                                    Visibility="{x:Bind Vm.CfShowLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <Border x:Name="QojLoginStatePanel"
                            MinHeight="58"
                            Padding="14,9"
                            CornerRadius="{StaticResource RepeatedItemCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind Vm.QojShowInitializing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}"
                                         Visibility="{x:Bind Vm.QojShowChallenge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                         Visibility="{x:Bind Vm.QojShowNotLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind Vm.QojShowLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Vm.QojStateTitle, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Vm.QojStatus, Mode=OneWay}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="同步该账号"
                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                    Click="OnSyncQoj"
                                    IsEnabled="{x:Bind Vm.CanSyncQoj, Mode=OneWay}"
                                    Visibility="{x:Bind Vm.QojShowLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Shared browser surface -->
            <Border Grid.Row="1" CornerRadius="{StaticResource SurfaceCornerRadius}" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="12,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="BrowserPlatformLabel"
                                       Grid.Column="1"
                                       Text="Codeforces 浏览器"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="BrowserFitStatusLabel"
                                       Grid.Column="2"
                                       Text="等待网页"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button Grid.Column="3"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    Width="30" Height="30" MinWidth="30" MinHeight="30"
                                    Click="OnFitBrowserWidth"
                                    ToolTipService.ToolTip="适应网页宽度">
                                <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <webview2:WebView2 Grid.Row="1" x:Name="Web" />
                </Grid>
            </Border>

            <!-- Progress + status -->
            <StackPanel Grid.Row="2" Spacing="6">
                <InfoBar IsOpen="{x:Bind Vm.HasSyncStatus, Mode=OneWay}"
                         IsClosable="False"
                         Severity="{x:Bind Vm.SyncSeverity, Mode=OneWay}"
                         Title="{x:Bind Vm.SyncTitle, Mode=OneWay}"
                         Message="{x:Bind Vm.SyncStatus, Mode=OneWay}" />
                <Button Content="取消同步" Click="OnCancelSync" HorizontalAlignment="Right"
                        Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- ===== Right: tracked accounts + conflicts ===== -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppSurfaceBorderStyle}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + "+" add button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="已跟踪账号" Style="{StaticResource AppSectionTitleTextBlockStyle}"
                            VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="AddAccountBtn"
                        Style="{StaticResource AppCompactButtonStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加账号" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="添加 Codeforces 账号" Click="OnAddCfAccount">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="添加 QOJ 账号" Click="OnAddQojAccount">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Accounts list -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Accounts}" SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItem">
                        <Border Padding="12" CornerRadius="{StaticResource RepeatedItemCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Platform badge -->
                                <Border Grid.Column="0" CornerRadius="4" Padding="7,2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="{x:Bind PlatformBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Info stack: handle / sync time / submission count / error -->
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Handle}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind ShowCurrentBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Bind CurrentBadge}" FontSize="11"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind LastSyncedText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="VP" />
                                        <Run Text="{x:Bind VpSolved}" FontWeight="SemiBold" />
                                        <Run Text="题 · 提交" />
                                        <Run Text="{x:Bind TotalSubmissions}" FontWeight="SemiBold" />
                                        <Run Text="条" />
                                    </TextBlock>
                                    <!-- Error hint (only shown when last sync failed) -->
                                    <TextBlock Text="{x:Bind LastSyncError}" FontSize="11"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind HasSyncError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Remove button as icon-only -->
                                <Button Grid.Column="2" VerticalAlignment="Top"
                                         Click="OnRemoveAccount" Tag="{x:Bind Handle}"
                                         Background="Transparent" BorderThickness="0"
                                         Style="{StaticResource AppIconButtonStyle}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="移除此账号" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Conflicts section -->
            <TextBlock Grid.Row="2" Text="选择计入统计的账号"
                       Style="{StaticResource AppSectionTitleTextBlockStyle}"
                       Visibility="{x:Bind Vm.HasConflicts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer Grid.Row="3" MaxHeight="260"
                          Visibility="{x:Bind Vm.HasConflicts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind Vm.Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConflictItem">
                            <Border CornerRadius="{StaticResource RepeatedItemCornerRadius}" Padding="12" Margin="0,0,0,8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind StatusText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ConflictCandidateItem">
                                                <Grid Padding="0,3" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Button Grid.Column="1" Content="选此项"
                                                            Style="{StaticResource AppCompactButtonStyle}"
                                                            Click="OnResolveConflict"
                                                            IsEnabled="{x:Bind IsSelected, Converter={StaticResource InverseBool}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
</Page>

