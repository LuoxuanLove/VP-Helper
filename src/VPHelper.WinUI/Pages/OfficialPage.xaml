<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VPHelper.WinUI.Pages.OfficialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VPHelper.WinUI.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="Root"
          MaxWidth="1608" HorizontalAlignment="Stretch"
          Padding="{StaticResource PagePadding}"
          RowSpacing="14"
          IsTabStop="True"
          PointerPressed="OnPagePointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + actions -->
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="比赛关联" Style="{StaticResource AppPageTitleTextBlockStyle}" />
            <TextBlock Text="将本地比赛与官方赛事对应，解锁推算排名；先自动关联，再处理剩余比赛。"
                       Style="{StaticResource AppPageDescriptionTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnAutoMatch"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    IsEnabled="{x:Bind Vm.IsNotBusy, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                    <TextBlock Text="自动关联全部" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Content="取消" Click="OnCancel" Style="{StaticResource AppCompactButtonStyle}"
                    Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar Grid.Column="2" VerticalAlignment="Center" Value="{x:Bind Vm.Progress, Mode=OneWay}"
                         Maximum="100" Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="1">
                <TextBlock Text="{x:Bind Vm.OverviewSummary, Mode=OneWay}"
                           HorizontalAlignment="Right"
                           FontSize="12" />
                <TextBlock Text="{x:Bind Vm.PlatformSummary, Mode=OneWay}"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Primary surface: bulk auto-match overview table -->
        <Border Grid.Row="2" Style="{StaticResource AppSurfaceBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="搜索本地比赛、官方名称或 ID"
                             Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="搜索比赛关联"/>
                    <ComboBox Grid.Column="1" Width="140" SelectedIndex="{x:Bind Vm.MappingFilter, Mode=TwoWay}"
                              AutomationProperties.Name="关联状态">
                        <ComboBoxItem Content="全部关联状态"/><ComboBoxItem Content="待关联"/><ComboBoxItem Content="已关联"/>
                    </ComboBox>
                </Grid>

                <!-- Column headers -->
                <Grid Grid.Row="1" MinHeight="34" Padding="8,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="本地比赛" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="官方比赛" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                    <TextBlock Grid.Column="4" Text="操作" TextAlignment="Center"
                               Style="{StaticResource AppTableHeaderTextBlockStyle}" />
                </Grid>

                <ListView x:Name="OverviewList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind Vm.VisibleOverview}"
                          SelectionMode="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PointerPressed="OnOverviewListPointerPressed"
                          PointerWheelChanged="OnOverviewListPointerWheelChanged"
                          Visibility="{x:Bind Vm.IsContentReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MappingRowItem">
                            <Grid MinHeight="60" Padding="8,6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ColumnSpacing="10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="7,2"
                                            CornerRadius="4"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding PlatformBadge}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <HyperlinkButton Padding="0"
                                                         HorizontalAlignment="Left"
                                                         Tag="{Binding ContestUrl}"
                                                         Click="OnContestLinkClick">
                                            <TextBlock Text="{Binding ContestIdText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </HyperlinkButton>
                                        <TextBlock Text="{Binding ContestTitleText}"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasDistinctContestTitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OfficialDisplay}" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisibility}}" />
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            MinHeight="36"
                                            Padding="12,6"
                                            CornerRadius="4"
                                            Tag="{Binding}"
                                            Click="OnOpenOfficialPicker"
                                            Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OfficialPickerText}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE721;"
                                                      FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding MatchSourceText}" VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" />
                                <Button Grid.Column="4" Content="确认" FontSize="12" Padding="10,4"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        Click="OnAcceptRow"
                                        IsEnabled="{Binding CanConfirm}"
                                        Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVisibility}}" />
                                <Button Grid.Column="4" Content="解除" FontSize="12" Padding="10,4"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        Click="OnClearRow"
                                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2" Text="{x:Bind Vm.OverviewEmptyText, Mode=OneWay}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind Vm.ShowOverviewEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                                  Width="36"
                                  Height="36" />
                    <TextBlock Text="正在加载官方比赛和关联信息..."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status + attribution -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.Attribution}" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Popup x:Name="OfficialPickerPopup"
               IsLightDismissEnabled="True"
               Closed="OnOfficialPickerClosed">
            <Border Width="600"
                    MaxHeight="500"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfficialPickerTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 PlaceholderText="搜索官方比赛"
                                 TextChanged="OnOfficialPickerTextChanged"
                                 KeyDown="OnOfficialPickerKeyDown" />
                        <Button Grid.Column="1"
                                Style="{StaticResource AppIconButtonStyle}"
                                Click="OnClearOfficialPickerText">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource AppIconButtonStyle}"
                                Click="OnCloseOfficialPicker" ToolTipService.ToolTip="关闭比赛选择" AutomationProperties.Name="关闭比赛选择">
                            <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView x:Name="OfficialPickerSuggestions"
                              Grid.Row="1"
                              MaxHeight="380"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnOfficialPickerSuggestionClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateItem">
                                <Grid Padding="4,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind OfficialName}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DetailText}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Visibility="{x:Bind HasDateText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind DateText}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>
